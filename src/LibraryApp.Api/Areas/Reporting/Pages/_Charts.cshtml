@model IndexModel
<section class="card" aria-labelledby="charts-title">
    <div class="card-head">
        <div>
            <div class="row"><h2 id="charts-title">Charts</h2><span class="badge badge-blue">Admin only</span></div>
            <p class="small muted">The dashboard, the tops and reading activity of the reports above, as bars.</p>
        </div>
    </div>
    <div class="grid grid-2">
        @foreach (var chart in Model.Charts)
        {
            <partial name="_BarChart" model="chart" />
        }
    </div>
</section>
