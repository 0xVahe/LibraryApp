@model IndexModel
@using System.Globalization
<form class="card" method="get" action="@(UiNavigation.Reports)#period-title" aria-labelledby="period-title">
    <h2 id="period-title" class="mb-4">Report period</h2>
    <p class="small muted mb-16">Applies to the reports below.</p>
    @if (Model.DepartmentId is { } departmentId)
    {
        <input type="hidden" name="departmentId" value="@departmentId" />
    }
    @if (Model.Days is { } days)
    {
        <input type="hidden" name="days" value="@days" />
    }
    <div class="row filters">
        <div class="field grow-160">
            <label for="period-from">From</label>
            <input id="period-from" name="from" type="date" required value="@Model.PeriodFrom.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-invalid="@(Model.PeriodError is null ? null : "true")">
        </div>
        <div class="field grow-160">
            <label for="period-to">To</label>
            <input id="period-to" name="to" type="date" required value="@Model.PeriodTo.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-invalid="@(Model.PeriodError is null ? null : "true")">
        </div>
        <button class="btn btn-primary self-end" type="submit">Show period</button>
    </div>
    @if (Model.PeriodError is { } error)
    {
        <p class="error-text mt-12" id="period-error">@error</p>
    }
    else
    {
        <p class="small muted mt-12">Showing @IndexModel.Date(Model.PeriodFrom) – @IndexModel.Date(Model.PeriodTo).</p>
    }
</form>
