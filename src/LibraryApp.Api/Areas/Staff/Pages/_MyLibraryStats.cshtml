@using LibraryApp.Application.Staff.Dto
@using LibraryApp.Domain.Staff
@model MyLibraryDto
<div class="grid grid-4" role="group" aria-label="My library summary">
    <div class="card stat" id="my-loans-stat">
        <span class="small muted">Books on loan</span>
        <span class="stat-value">@Model.ActiveLoans.Count</span>
    </div>
    <div class="card stat" id="my-reservations-stat">
        <span class="small muted">Reservations</span>
        <span class="stat-value">@Model.Reservations.Count</span>
    </div>
    <div class="card stat" id="my-penalties-stat">
        <span class="small muted">Penalty points</span>
        <span class="stat-value">@Model.ActivePenaltyPoints</span>
    </div>
    <div class="card stat" id="my-status-stat">
        <span class="small muted">Library access</span>
        <span class="stat-value"><partial name="/Pages/Shared/_StatusBadge.cshtml" model="Enum.Parse<StaffMemberStatus>(Model.Profile.Status)" /></span>
    </div>
</div>
