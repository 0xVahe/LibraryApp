@model IReadOnlyList<LibraryApp.Application.Staff.Dto.StaffImportError>
@{
    var fileInvalid = Model.Any(error => error.Field == "File");
}
<div class="stack">
    <section class="card" aria-labelledby="import-title">
        <div class="card-head"><h2 id="import-title">Import from CSV</h2></div>
        <p class="small">Use UTF-8 CSV with department and category names. Up to 200 data rows, 1 MB.</p>
        <p class="hint">All rows are imported together. If any row is invalid, nothing is imported.</p>
        <form class="form mt-24 staff-csv-import" method="post" asp-page="./Import" enctype="multipart/form-data" novalidate data-staff-csv-import>
            <div class="drop" data-import-file>
                <label for="csv-file">Choose a CSV file</label>
                <input id="csv-file" name="CsvFile" type="file" accept=".csv,text/csv"
                       aria-invalid="@(fileInvalid ? "true" : null)" aria-describedby="csv-hint">
                <span class="hint" id="csv-hint">EmployeeId, FirstName, LastName, CorporateEmail, Department, Position, LineManagerEmail, Category; Role is optional.</span>
            </div>
            <div>
                <button class="btn btn-primary btn-block" type="submit">
                    <span class="staff-import-spinner" aria-hidden="true" hidden></span>
                    <span data-import-label>Import</span>
                </button>
                <p class="hint mt-8" role="status" aria-atomic="true" data-import-status></p>
            </div>
            <a class="link-btn small" asp-page="./Import" asp-page-handler="Template" data-import-template>Download the template</a>
            <div hidden data-import-recovery>
                <p class="small">If the import appears stuck, you can reload this form. An interrupted request may still complete on the server; its outcome is unknown. Check Staff members before importing again.</p>
                <a class="btn btn-secondary mt-8" asp-page="./Import">Reload import form</a>
            </div>
        </form>
    </section>
    @if (Model.Count > 0)
    {
        <section class="card flush" aria-labelledby="import-errors-title">
            <div class="card-head">
                <div>
                    <h2 id="import-errors-title">Import errors</h2>
                    <p class="small">Nothing was imported. Correct these errors and choose the file again.</p>
                </div>
            </div>
            <table class="table">
                <thead><tr><th scope="col">Row</th><th scope="col">Field</th><th scope="col">Error</th></tr></thead>
                <tbody>
                @foreach (var error in Model)
                {
                    <tr>
                        <td data-label="Row">@error.RowNumber</td>
                        <td data-label="Field">@error.Field</td>
                        <td data-label="Error">@error.Message</td>
                    </tr>
                }
                </tbody>
            </table>
        </section>
    }
</div>
<script src="~/js/staff-csv-import.js" asp-append-version="true" defer></script>
