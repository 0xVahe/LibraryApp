@page "/login"
@model LoginModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Sign in";
    var emailError = Model.FieldError("Input.Email");
    var passwordError = Model.FieldError("Input.Password");
}
<h2>Sign in</h2>
<p class="muted">Use your corporate email and password.</p>
<form class="form" method="post" novalidate>
    <div class="field">
        <label for="email">Corporate email</label>
        <input id="email" name="Input.Email" type="email" value="@Model.Input.Email" autocomplete="username"
               placeholder="name.surname@ameriabank.am"
               aria-invalid="@(emailError is null ? null : "true")" aria-describedby="@(emailError is null ? null : "email-error")">
        @if (emailError is not null)
        {
            <span class="error-text" id="email-error">@emailError</span>
        }
    </div>
    <div class="field">
        <label for="password">Password</label>
        <input id="password" name="Input.Password" type="password" autocomplete="current-password"
               aria-invalid="@(passwordError is null ? null : "true")" aria-describedby="@(passwordError is null ? null : "password-error")">
        @if (passwordError is not null)
        {
            <span class="error-text" id="password-error">@passwordError</span>
        }
    </div>
    <button class="btn btn-primary btn-block" type="submit">Sign in</button>
</form>
@if (Model.Alert is not null)
{
    <div class="mt-24"><partial name="/Pages/Shared/_Alert.cshtml" model="Model.Alert" /></div>
}
<div class="small muted mt-24">No account yet? Ask the library administrator to enrol you.</div>
