@page "/staff/{id:guid}/edit"
@model EditModel
@{
    ViewData["Title"] = "Edit staff member";
}
<partial name="/Pages/Shared/_PageHead.cshtml"
         model='@(new PageHeadModel("Edit staff member",
             $"{Model.Member.FirstName} {Model.Member.LastName}",
             Actions: [new PageAction("View staff member", $"/staff/{Model.Member.Id}")],
             Crumbs: [new PageAction("Staff members", "/staff")]))' />
@if (Model.IsDeactivated)
{
    <section class="card" aria-labelledby="locked-title">
        <div class="card-head"><h2 id="locked-title">Profile locked</h2></div>
        <p class="alert alert-amber mb-16">This staff member is deactivated. Their profile cannot be edited.</p>
        <a class="btn btn-secondary" href="/staff/@Model.Member.Id">Back to staff member</a>
    </section>
}
else
{
    <partial name="_EditStaffForm" model="Model" />
}
