@page "/change-password"
@model ChangePasswordModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Change password";
    var currentError = Model.FieldError("Input.CurrentPassword");
    var newError = Model.FieldError("Input.NewPassword");
    var repeatError = Model.FieldError(nameof(Model.RepeatPassword));
}
<h2>@(Model.FirstLogin ? "Choose your password" : "Change password")</h2>
<p class="muted">
    @(Model.FirstLogin ? "You signed in with a temporary password. Choose your own to continue." : "After the change you sign in again.")
    At least 8 characters with a letter and a digit.
</p>
<form class="form" method="post" novalidate>
    <div class="field">
        <label for="current">@(Model.FirstLogin ? "Temporary password" : "Current password")</label>
        <input id="current" name="Input.CurrentPassword" type="password" autocomplete="current-password"
               aria-invalid="@(currentError is null ? null : "true")" aria-describedby="@(currentError is null ? null : "current-error")">
        @if (currentError is not null)
        {
            <span class="error-text" id="current-error">@currentError</span>
        }
    </div>
    <div class="field">
        <label for="new">New password</label>
        <input id="new" name="Input.NewPassword" type="password" autocomplete="new-password"
               aria-invalid="@(newError is null ? null : "true")" aria-describedby="@(newError is null ? null : "new-error")">
        @if (newError is not null)
        {
            <span class="error-text" id="new-error">@newError</span>
        }
    </div>
    <div class="field">
        <label for="repeat">Repeat new password</label>
        <input id="repeat" name="RepeatPassword" type="password" autocomplete="new-password"
               aria-invalid="@(repeatError is null ? null : "true")" aria-describedby="@(repeatError is null ? null : "repeat-error")">
        @if (repeatError is not null)
        {
            <span class="error-text" id="repeat-error">@repeatError</span>
        }
    </div>
    <button class="btn btn-primary btn-block" type="submit">Change password</button>
</form>
@if (Model.Alert is not null)
{
    <div class="mt-24"><partial name="/Pages/Shared/_Alert.cshtml" model="Model.Alert" /></div>
}
@if (Model.FirstLogin)
{
    <form class="mt-24" method="post" action="@UiPaths.Logout" asp-antiforgery="true">
        <button class="btn btn-secondary btn-block" type="submit">Sign out</button>
    </form>
}
else
{
    <div class="small muted mt-24"><a href="/">Back to the start page</a></div>
}