@page "/my-library"
@model MyLibraryModel
@{
    ViewData["Title"] = "My library";
    var memberId = Model.Profile.Id;
}
<partial name="/Pages/Shared/_PageHead.cshtml"
         model='@(new PageHeadModel($"Hello, {Model.Profile.FirstName}",
             "Your books, reservations and standing in the library.",
             [new PageAction("Browse the catalog", UiNavigation.Catalog, Primary: true)]))' />

<div class="stack-lg">
    <vc:overdue-banner staff-member-id="@memberId" />
    <partial name="_MyLibraryStats" model="Model" />
    <div class="grid grid-side">
        <div class="stack-lg">
            <vc:my-loans staff-member-id="@memberId" />
            <vc:my-reservations staff-member-id="@memberId" />
        </div>
        <aside class="stack-lg" aria-label="My profile and standing">
            <vc:my-profile-card />
            <vc:my-penalties staff-member-id="@memberId" />
            <vc:latest-notifications />
        </aside>
    </div>
</div>
