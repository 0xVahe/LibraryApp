{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/libraryapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LibraryDb": ""
  },
  "Time": {
    "TimeZoneId": "Asia/Yerevan"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "Catalog": {
    "Covers": {
      "BaseUrl": "https://res.cloudinary.com/hil9ktuv/image/upload/"
    }
  },
  "CorporateEmail": {
    "Domain": "ameriabank.am"
  },
  "Jwt": {
    "Issuer": "LibraryApp",
    "Audience": "LibraryApp.Api",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "SecurityStampCacheSeconds": 30
  },
  "Mail": {
    "Host": "localhost",
    "Port": 2525,
    "Security": "None",
    "FromAddress": "library@ameriabank.am",
    "FromName": "Ameriabank Library",
    "TimeoutSeconds": 10
  },
  "Notifications": {
    "Delivery": {
      "PollInterval": "00:00:05",
      "BatchSize": 20,
      "Lease": "00:15:00"
    }
  },
  "LoginRateLimit": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Ui": {
    "SecurityStampValidationInterval": "00:05:00"
  },
  "UseHttpsRedirection": true,

  "Jobs": {
    "Enabled": true,
    "PollInterval": "00:01:00",
    "Lease": "01:00:00",
    "RetryDelay": "00:15:00",
    "MaxAttemptsPerDay": 5,
    "Schedules": {
      "Borrowing": {
        "Enabled": true,
        "RunAt": "00:30",
        "WorkingDaysOnly": false
      }
    }
  },

  "WorkingDayCalendar": {
    "Holidays": [
      "2026-01-01",
      "2026-01-02",
      "2026-01-06",
      "2026-01-27",
      "2026-01-28",
      "2026-03-08",
      "2026-04-24",
      "2026-05-01",
      "2026-05-09",
      "2026-05-28",
      "2026-07-05",
      "2026-09-21",
      "2026-12-31"
    ]
  },

  "Borrowing": {
    "Penalties": {
      "PointsPerLateWorkingDay": 1,
      "MaxLatePoints": 10,
      "DamagedPoints": 5,
      "LostPoints": 10,
      "LifetimeDays": 90,
      "RestrictedFromPoints": 5,
      "SuspendedFromPoints": 10,
      "LateAndDamaged": "Sum",
      "SuspensionDays": 30
    },
    "Loans": {
      "OverdueFrom": "NextLocalDay",
      "AllowLostBeforeDue": true
    },
    "Reservations": {
      "MaxActive": 3,
      "PickupWorkingDays": 3,
      "PickupCountsReleaseDay": false,
      "RestrictedMayReserve": false,
      "SuspendedMayReserve": false,
      "AnyCopyFulfils": true
    }
  }
}
