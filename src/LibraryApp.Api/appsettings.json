{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/libraryapp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "LibraryDb": ""
  },
  "Time": {
    "TimeZoneId": "Asia/Yerevan"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "UseHttpsRedirection": true

  
  "WorkingDayCalendar": {
    "Holidays": [
      "2026-01-01",
      "2026-01-02",
      "2026-01-06",
      "2026-04-24",
      "2026-05-01",
      "2026-05-09",
      "2026-05-28",
      "2026-07-05",
      "2026-09-21",
      "2026-12-31"
    ]
  } 
}

