# Copy this file to .env (git-ignored) and set a password before `docker compose up -d`.
# MSSQL_SA_PASSWORD is required: SQL Server won't start without it.
# Rules: 8+ chars, with 3 of: uppercase, lowercase, digit, symbol (e.g. LocalDev_2026!).
# The password goes into connection strings: do not use ; $ " ' or spaces in it.
MSSQL_SA_PASSWORD=
MSSQL_PORT=1433
# Port of the API container on this machine (docker compose up): http://localhost:8080/swagger
API_PORT=8080

# Built from the values above, no need to edit.
LIBRARYAPP_TEST_DB="Server=localhost,${MSSQL_PORT};User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True"
LIBRARYAPP_DESIGNTIME_DB="Server=localhost,${MSSQL_PORT};Database=LibraryApp;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True"
# The API started from the IDE (Development) uses the SQL Server above. Remove the line to use LocalDB.
ConnectionStrings__LibraryDb="Server=localhost,${MSSQL_PORT};Database=LibraryApp;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True"

# JWT signing key (32+ random bytes), required by docker compose and by the API in Development.
# Generate one: openssl rand -base64 32
JWT_SIGNING_KEY=